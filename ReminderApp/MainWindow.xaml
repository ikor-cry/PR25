<Window x:Class="ReminderApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Умная напоминалка"
        Height="500"
        Width="750"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="Умная напоминалка"
               FontSize="24"
               FontWeight="Bold"
               HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="1" Margin="5">
            <TextBlock Text="Добавить напоминание"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,5"/>

            <WrapPanel>
                <StackPanel Margin="5">
                    <Label Content="Часы"/>
                    <TextBox x:Name="HourTextBox" Width="70"/>
                </StackPanel>

                <StackPanel Margin="5">
                    <Label Content="Минуты"/>
                    <TextBox x:Name="MinuteTextBox" Width="70"/>
                </StackPanel>

                <StackPanel Margin="5">
                    <Label Content="Текст напоминания"/>
                    <TextBox x:Name="TextReminderTextBox" Width="250"/>
                </StackPanel>

                <Button Content="Добавить"
                        Width="100"
                        Height="30"
                        Margin="10,25,5,5"
                        Click="AddButton_Click"/>
            </WrapPanel>
        </StackPanel>

        <DataGrid x:Name="RemindersGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  Margin="5"
                  AlternatingRowBackground="#E3F2FD"
                  HeadersVisibility="Column">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Часы"
                                    Binding="{Binding Hour}"
                                    Width="70"/>

                <DataGridTextColumn Header="Минуты"
                                    Binding="{Binding Minute}"
                                    Width="70"/>

                <DataGridTextColumn Header="Текст"
                                    Binding="{Binding Text}"
                                    Width="*"/>

                <DataGridCheckBoxColumn Header="Показано"
                                        Binding="{Binding IsShown}"
                                        Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="5">

            <Button Content="Удалить"
                    Width="110"
                    Height="30"
                    Margin="5"
                    Click="DeleteButton_Click"/>

            <Button Content="Открыть"
                    Width="110"
                    Height="30"
                    Margin="5"
                    Click="OpenButton_Click"/>

            <Button Content="Сохранить"
                    Width="110"
                    Height="30"
                    Margin="5"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>